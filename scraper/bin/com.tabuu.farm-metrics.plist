<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tabuu.farm-metrics</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/a1111/.local/bin/tabuu_daily_pull.sh</string>
    </array>

    <!-- Run daily at 08:00 local time. If the Mac is asleep, runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/a1111/Library/Logs/tabuu-farm/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a1111/Library/Logs/tabuu-farm/launchd.err.log</string>
</dict>
</plist>
